<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp" >

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_gravity="top"
            android:layout_margin="0dp"
            android:alpha="1"
            android:padding="0dp"
            android:layout_marginTop="-20dp"
            android:layout_marginStart="-20dp"
            android:layout_marginEnd="-20dp"
            android:scaleType="centerCrop"
            android:src="@drawable/medical_medi" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#00695C"
            android:text="SymptoCare Result ...."
            android:textSize="24sp"
            android:textStyle="bold" />


 <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="12dp"
     android:layout_marginBottom="8dp"
     android:orientation="vertical"
     android:background="@drawable/result_box_background"
     android:padding="12dp">

     <TextView
         android:id="@+id/conditionHeading"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="10dp"
         android:textColor="#2E7D32"
         android:fontFamily="sans-serif-medium"
         android:text="Possible Condition"
         android:textSize="18sp"
         android:textStyle="bold" />

     <TextView
         android:id="@+id/conditionText"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="4dp"
         android:gravity="top"
         android:textColor="#4F6354"
         android:fontFamily="@font/anek_tamil_semibold"
         android:text="Condition will appear here"
         android:textSize="15sp" />
 </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:background="@drawable/result_box_background"
        android:padding="10dp">

        <TextView
            android:id="@+id/symptomsHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:text="Symptoms"
            android:textColor="#2E7D32"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/symptomsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#4F6354"
            android:fontFamily="@font/anek_tamil_semibold"
            android:text="Symptoms will appear here"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:background="@drawable/result_box_background"
        android:padding="10dp">

        <TextView
            android:id="@+id/preventionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:fontFamily="sans-serif-medium"
            android:text="Prevention"
            android:textColor="#2E7D32"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/preventiontext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#4F6354"
            android:fontFamily="@font/anek_tamil_semibold"
            android:text="Prevention information will appear here"
            android:textSize="15sp" />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:background="@drawable/result_box_background"
        android:padding="10dp">

        <TextView
            android:id="@+id/homeCareHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:text="HomeCare"
            android:textSize="18sp"
            android:textColor="#2E7D32"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/homeCareText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#4F6354"
            android:fontFamily="@font/anek_tamil_semibold"
            android:text="Home care information will appear here"
            android:textSize="15sp" />
    </LinearLayout>


        <FrameLayout
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_gravity="top"
            android:layout_marginStart="220dp"
            android:alpha="1"
            android:scaleType="centerInside"
            android:src="@drawable/medical_bottle" />
     <Button
        android:id="@+id/checkAgainButton"
        android:background="@drawable/button_background"
        android:layout_width="200dp"
        android:backgroundTint="@null"
        android:layout_height="55dp"
        android:layout_marginTop="24dp"
        android:text="CHECK AGAIN"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_gravity="center"/>

        </FrameLayout>

    </LinearLayout>
</ScrollView>