<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top"
        android:layout_margin="0dp"
        android:alpha="1"
        android:scaleType="centerCrop"
        android:src="@drawable/medical_medi" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="570dp"
        android:layout_weight="0.65"
        android:src="@drawable/medical_symbol"
        android:scaleType="fitCenter"
        android:alpha="0.25"
        android:layout_gravity="center"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="10dp"/>



 <LinearLayout
     android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#5DF7FAF5"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

     <Space
         android:layout_width="match_parent"
         android:layout_height="0dp"
         android:layout_weight="0.1" />


     <TextView
         android:id="@+id/textView2"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:fontFamily="serif"
         android:text="SymptoCare"
         android:layout_marginTop="40dp"
         android:textColor="#004D40"
         android:textSize="36sp"
         android:textStyle="bold" />

     <TextView
         android:id="@+id/textView5"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginTop="12dp"
         android:layout_gravity="center_horizontal"
         android:gravity="center"
         android:fontFamily="serif"
         android:text="Smart Symptom Checker"
         android:textColor="#37474F"
         android:textSize="10sp" />

     <Space
         android:layout_width="match_parent"
         android:layout_height="0dp"
         android:layout_weight="0.3" />


     <TextView
         android:id="@+id/textView6"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="20dp"
         android:fontFamily="sans-serif"
         android:gravity="center"
         android:text="Enter your symptoms and get basic health information."
         android:textColor="#355E5A"
         android:textStyle="bold"
         android:textSize="25sp" />

     <Space
         android:layout_width="match_parent"
         android:layout_height="0dp"
         android:layout_weight="0.3" />

     <Button
         android:id="@+id/startButton"
         android:layout_width="190dp"
         android:layout_height="55dp"
         android:layout_marginTop="32dp"
         android:background="@drawable/button_background"
         android:elevation="6dp"
         android:fontFamily="sans-serif"
         android:text="Start Checking"
         android:textColor="#FFFFFF"
         android:textSize="14sp"
         android:textStyle="bold" />

     <Space
         android:layout_width="match_parent"
         android:layout_height="0dp"
         android:layout_weight="0.02" />
 </LinearLayout>

</FrameLayout>
